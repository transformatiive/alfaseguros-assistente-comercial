# ---------------------------------------------------------------------------
# Alfaseguros Supervisor Virtual — example environment
#
# Copy to `.env` for local development. On Railway these are set as service
# variables; on Replit they live in Secrets (plus `.replit` [userenv.shared]).
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------

# "development" | "production"
NODE_ENV=development

# Port the Express API binds to. Also required by artifacts/supervisor/vite.config.ts
# at *build* time, so it must be present in the build environment as well.
PORT=3000

# Public base path the SPA is served from. Required by vite.config.ts — the build
# fails if it is unset. Use "/" when Express serves the SPA from the root of a
# single origin (Railway). A future per-agent app would use e.g. "/agente/".
BASE_PATH=/

# --- Database --------------------------------------------------------------

# On Railway, set this as a reference to the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/supervisor

# --- Sessions --------------------------------------------------------------

# Must be a real random secret in production. The code defaults to
# "change-me-in-production" — that default must never reach a deployed env.
SESSION_SECRET=change-me-in-production

# Absolute public URL of the deployment (used to build links). Do not copy the
# Replit value to Railway — set it to the Railway domain.
PUBLIC_APP_URL=http://localhost:3000

# --- External services -----------------------------------------------------

RINGOVER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Concurrency for the per-conversation analysis queue.
ANALYSIS_CONCURRENCY=4

# Shared secret checked against the X-Cron-Secret header on POST /api/run.
CRON_WEBHOOK_SECRET=

# Bearer token n8n uses on the /api/followups/* endpoints.
FOLLOWUP_API_TOKEN=

# --- Zoho Desk (Phase 2A) --------------------------------------------------

ZOHO_DESK_CLIENT_ID=
ZOHO_DESK_CLIENT_SECRET=
ZOHO_DESK_REFRESH_TOKEN=
ZOHO_DESK_ORG_ID=
# Department id for the /leads dashboard (Não Vida). Has a code default.
ZOHO_DESK_NAOVIDA_DEPARTMENT_ID=

# --- Team configuration ----------------------------------------------------

# JSON map of Ringover numeric user_id -> email. Load-bearing for
# GET /api/followups/pending. NOTE: on Replit this lives in `.replit` under
# [userenv.shared], NOT in Replit Secrets — it is easy to miss when migrating.
AGENT_EMAIL_MAP={"23275673":"agent.one@example.com"}

# Comma-separated Ringover numeric user_ids to exclude (extends the hardcoded Vida set).
VIDA_AGENT_IDS=

# Comma-separated product names excluded from pending follow-ups. Default: "TVDE,Caravela".
FOLLOWUP_EXCLUDE_PRODUCTS=
