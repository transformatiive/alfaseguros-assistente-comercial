modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 21898
externalPort = 3000

[userenv]

[userenv.shared]
AGENT_EMAIL_MAP = "{\"23275673\":\"vania.rodrigues@alfaseguros.pt\",\"23275674\":\"tiago.paiva@alfaseguros.pt\",\"23275675\":\"marina.fernandes@alfaseguros.pt\",\"23275677\":\"andreia.coelho@alfaseguros.pt\",\"23275678\":\"joao.martins@alfaseguros.pt\",\"23275679\":\"ana.inacio@alfaseguros.pt\"}"
